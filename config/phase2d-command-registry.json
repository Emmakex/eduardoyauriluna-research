{
  "version": "1",
  "tenants": {
    "eduardo-research": {"enabled": true}
  },
  "actions": {
    "insight.create": {
      "required_capabilities": ["insights.write", "operations.rollback"],
      "tools": {
        "capabilities": "research_capabilities",
        "plan": "site_insight_create_plan",
        "apply": "site_insight_apply",
        "verify": "site_insight_verify",
        "rollback": "site_insight_rollback"
      },
      "verify_rendered": true,
      "allowed_statuses": ["draft"]
    },
    "insight.update": {
      "required_capabilities": ["insights.write", "operations.rollback"],
      "tools": {
        "capabilities": "research_capabilities",
        "plan": "site_insight_update_plan",
        "apply": "site_insight_apply",
        "verify": "site_insight_verify",
        "rollback": "site_insight_rollback"
      },
      "verify_rendered": true,
      "allowed_change_fields": ["title", "excerpt", "content", "language", "insight_type"]
    },
    "page.slot.update": {
      "required_capabilities": ["pages.write", "operations.rollback"],
      "tools": {
        "capabilities": "research_capabilities",
        "plan": "site_page_slots_plan",
        "apply": "site_page_slots_apply",
        "verify": "site_page_slots_verify",
        "rollback": "site_page_slots_rollback"
      },
      "verify_rendered": true,
      "allowed_targets": [
        {"key": "contact", "language": "en", "slots": ["eyebrow"]}
      ]
    },
    "insight.translation.pair": {
      "required_capabilities": ["translations.write", "operations.rollback"],
      "tools": {
        "capabilities": "research_capabilities",
        "plan": "site_insight_pair_plan",
        "apply": "site_insight_pairing_apply",
        "verify": "site_insight_pairing_verify",
        "rollback": "site_insight_pairing_rollback"
      },
      "verify_rendered": false
    },
    "insight.translation.unpair": {
      "required_capabilities": ["translations.write", "operations.rollback"],
      "tools": {
        "capabilities": "research_capabilities",
        "plan": "site_insight_unpair_plan",
        "apply": "site_insight_pairing_apply",
        "verify": "site_insight_pairing_verify",
        "rollback": "site_insight_pairing_rollback"
      },
      "verify_rendered": false
    }
  }
}
