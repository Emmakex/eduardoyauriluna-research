{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduardoyauriluna.com/schemas/phase2e-design-variant-v1.schema.json",
  "title": "Phase 2E bounded Design component variant update command",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "tenant", "action", "requested_by", "payload"],
  "properties": {
    "version": {"const": "1"},
    "command_id": {"type": "string", "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"},
    "tenant": {"const": "eduardo-research"},
    "action": {"const": "design.variant.update"},
    "requested_by": {"const": "chatgpt"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes"],
      "properties": {
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "hero": {"enum": ["orbit", "editorial", "compact"]},
            "sections": {"enum": ["layered", "plain", "bands"]},
            "cards": {"enum": ["bordered", "lifted", "quiet"]},
            "collections": {"enum": ["editorial-grid", "compact-grid", "list"]}
          }
        }
      }
    }
  }
}
