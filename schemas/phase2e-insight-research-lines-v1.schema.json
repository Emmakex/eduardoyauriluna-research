{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduardoyauriluna.com/schemas/phase2e-insight-research-lines-v1.schema.json",
  "title": "Phase 2E bounded Insight to Research Line relation update",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "tenant", "action", "requested_by", "payload"],
  "properties": {
    "version": {"const": "1"},
    "command_id": {"type": "string", "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"},
    "tenant": {"const": "eduardo-research"},
    "action": {"const": "insight.research-lines.update"},
    "requested_by": {"const": "chatgpt"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "line_ids"],
      "properties": {
        "post_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "line_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
    }
  }
}
