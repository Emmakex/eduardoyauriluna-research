{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoseth.com/schemas/phase2d-command-v1.schema.json",
  "title": "Kairoseth Phase 2D Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command_id",
    "tenant",
    "action",
    "requested_by",
    "payload"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "action": {
      "const": "insight.create"
    },
    "requested_by": {
      "const": "chatgpt"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "status", "content"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "enum": ["es", "en"]
        },
        "status": {
          "const": "draft"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1000
        },
        "insight_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      }
    }
  }
}
