{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduardoyauriluna.com/schemas/phase2e-media-ingest-v1.schema.json",
  "title": "Phase 2E bounded Media ingest command",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "tenant", "action", "requested_by", "payload"],
  "properties": {
    "version": {"const": "1"},
    "command_id": {"type": "string", "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"},
    "tenant": {"const": "eduardo-research"},
    "action": {"const": "media.ingest"},
    "requested_by": {"const": "chatgpt"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "mime_type", "content_base64"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^/\\\\\\u0000]+$"},
        "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"]},
        "content_base64": {"type": "string", "minLength": 1, "maxLength": 6990508, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "alt_text": {"type": "string", "maxLength": 500},
        "caption": {"type": "string", "maxLength": 2000},
        "description": {"type": "string", "maxLength": 12000}
      }
    }
  }
}
