# Example only. Do not commit real bearer or Manager tokens.
# Merge these definitions into the existing shared production environment.

# Site Manager token generated in WordPress → Tools → Site Manager.
TENANT_EMMAKE_NUEVAWEB_READ_TOKEN=erm1_REPLACE_WITH_SITE_MANAGER_TOKEN

# Independent outer bearer used only by the ChatGPT project "Nueva web Emmake".
PRINCIPAL_NUEVAWEB_EMMAKE_TOKEN=REPLACE_WITH_STRONG_INDEPENDENT_OUTER_BEARER

# Tenant object to append to MCP_TENANTS_JSON:
