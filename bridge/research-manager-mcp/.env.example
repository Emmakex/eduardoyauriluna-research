# Commercial tenant registry. Prefer this mode for shared/platform deployments.
# Secrets are referenced by environment-variable name; they are never embedded in registry JSON.
# Entitlements are the product modules/capabilities contracted by the tenant.
# Example:
# MCP_TENANTS_JSON=[{"id":"eduardo-research","label":"Eduardo Research","adapter":"research-manager","baseUrl":"https://eduardoyauriluna.com","readTokenEnv":"TENANT_EDUARDO_READ_TOKEN","languages":["en","es"],"entitlements":["site.read","pages.read","seo.read"]},{"id":"client-two","label":"Client Two","adapter":"research-manager","baseUrl":"https://client-two.example","readTokenEnv":"TENANT_CLIENT_TWO_READ_TOKEN","languages":["es","en"],"entitlements":["site.read"]}]
# TENANT_EDUARDO_READ_TOKEN=ermt1_replace_with_least_privilege_site_read_credential
# TENANT_CLIENT_TWO_READ_TOKEN=ermt1_replace_with_second_least_privilege_credential
#
# Shared routing is explicit and deny-by-default. Each principal references its bearer secret,
# allowed tenants and commercial capabilities/role grants.
# MCP_SHARED_ROUTING=true
# MCP_PRINCIPALS_JSON=[{"id":"agency-workspace","bearerTokenEnv":"PRINCIPAL_AGENCY_TOKEN","tenants":["eduardo-research","client-two"],"capabilities":["site.read","pages.read","seo.read"]},{"id":"client-two-workspace","bearerTokenEnv":"PRINCIPAL_CLIENT_TWO_TOKEN","tenants":["client-two"],"capabilities":["site.read"]}]
# PRINCIPAL_AGENCY_TOKEN=replace_with_outer_mcp_principal_secret
# PRINCIPAL_CLIENT_TWO_TOKEN=replace_with_outer_mcp_principal_secret
# MCP_REQUESTS_PER_MINUTE=120
#
# Phase 2C production acceptance must use a dedicated principal instead of an operational
# principal or the Phase 2D GitHub principal. The current acceptance harness needs only
# site.read + navigation.read + design.read on the eduardo-research tenant.
# Example principal entry to add to MCP_PRINCIPALS_JSON:
# {"id":"phase2c-acceptance","bearerTokenEnv":"PRINCIPAL_PHASE2C_ACCEPTANCE_TOKEN","tenants":["eduardo-research"],"capabilities":["site.read","navigation.read","design.read"]}
# PRINCIPAL_PHASE2C_ACCEPTANCE_TOKEN=replace_with_dedicated_outer_acceptance_secret
# GitHub Environment secret MCP_ACCEPTANCE_TOKEN must contain this principal bearer only.
#
# Effective capability = tenant entitlement AND principal capability.
# If omitted, both tenant entitlements and principal capabilities default to site.read only.
# In shared mode the endpoint is /mcp/{tenant-id}; MCP_BEARER_TOKEN is not used.

# Backward-compatible single-tenant mode for local/reference deployments.
ERM_BASE_URL=https://eduardoyauriluna.com
ERM_READ_TOKEN=ermt1_replace_with_least_privilege_site_read_credential
ERM_TIMEOUT_MS=20000
MCP_TENANT_ID=eduardo-research
MCP_TENANT_LABEL=Eduardo Research
MCP_TENANT_LANGUAGES=en,es
MCP_TENANT_ENTITLEMENTS=site.read

# MCP listener
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8787
MCP_REQUESTS_PER_MINUTE=120

# Persistent production audit/usage telemetry.
# Production Compose mounts /var/lib/site-control-mcp on a dedicated persistent volume.
# Set both values in production so the service fails closed if durable telemetry is unavailable.
# MCP_TELEMETRY_PATH=/var/lib/site-control-mcp/events.jsonl
# MCP_REQUIRE_PERSISTENT_TELEMETRY=true

# Legacy single-tenant outer bearer. Required when binding single-tenant mode outside loopback.
# Keep separate from every Manager credential. Do not use with MCP_SHARED_ROUTING=true.
MCP_BEARER_TOKEN=

# Host/Origin boundary. For a public reverse-proxy deployment, set the public bridge hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGIN_HOSTS=
